# ReleaseProof environment. Copy to `.env` (never commit `.env`) and fill in the AMD endpoint.
# docker compose reads this file for the `api` service and for ${SITE_ADDRESS} in caddy.
# Values here are placeholders: no secrets.

# ---------------------------------------------------------------- platform
# dev | test | demo   (test enables stub LLM transports in unit tests only)
RELEASEPROOF_ENV=demo
# 1 = also list EXPERIMENTAL profiles (dev). Only SUPPORTED profiles are selectable otherwise.
RELEASEPROOF_EXPOSE_EXPERIMENTAL=0
# Extra CORS origins, comma separated (http://localhost:3000 is always allowed in dev/test).
RELEASEPROOF_CORS_ORIGINS=
# SSE heartbeat comment interval (seconds).
RELEASEPROOF_SSE_HEARTBEAT_SECONDS=15
RELEASEPROOF_MAX_ACTIVE_RUNS=4
RELEASEPROOF_MUTATION_RPM=20

# Set by docker-compose.yml for the containers; only needed when running the API on the host:
# RELEASEPROOF_DATA_DIR=./data                 # SQLite + runs/<run_id>/artifacts
# RELEASEPROOF_RUNNER_DATA_DIR=/data           # same volume as mounted inside the runners
# RUNNER_URL_WOLFBOOT=http://localhost:18080
# RUNNER_URL_MCUBOOT=http://localhost:18081
# RELEASEPROOF_CONTRACT_DIR=../contract/PQC_Engineering_Pack_V1_2
# RELEASEPROOF_REFERENCE_DIR=../reference/wp0-freeze-20261001
# RELEASEPROOF_PROFILES_DIR=../profiles

# ---------------------------------------------------------------- edge (Caddy)
# ":80" = plain HTTP. A hostname enables automatic HTTPS, e.g. "203-0-113-10.sslip.io"
# (derived from the Elastic IP) or "releaseproof.example.com" (DNS A record -> Elastic IP).
SITE_ADDRESS=:80
# Public judging is intentionally anonymous. Do not add login or browser credentials.

# ---------------------------------------------------------------- AMD-hosted LLM (OpenAI-compatible)
# Only endpoints that run inference on AMD hardware. No fallback to other providers.
AMD_LLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_LLM_API_KEY=
AMD_LLM_MODEL=DeepSeek-V4-Flash
# Optional per-module overrides
AMD_LLM_MODEL_PLANNER=
AMD_LLM_MODEL_EXPLAINER=
AMD_LLM_MODEL_ALTERNATIVES=
AMD_LLM_MODEL_ASSISTANT=
# Shown in the UI / AMD panel
AMD_LLM_PROVIDER_LABEL="AMD Token Factory"
# The shared catalog does not identify the GPU for each model. Do not claim MI300X.
AMD_LLM_HARDWARE_LABEL="AMD-hosted (GPU not disclosed)"
# Comma-separated host allowlist for AMD_LLM_BASE_URL
AMD_LLM_ALLOWED_HOSTS=developer.amd.com.cn
# Optional tuning (defaults in backend/releaseproof/ai/config.py)
# Shared Token Factory: JSON mode avoids observed upstream strict-schema timeouts.
# Outputs still undergo local JSON-schema, citation and verdict validation.
AMD_LLM_RESPONSE_FORMAT=json_object    # auto | json_schema | json_object | none
# Shared AMD guidance recommends streaming long generations to avoid idle upstream timeouts.
# Structured output is buffered and schema/citation/verdict-validated before it is published.
AMD_LLM_STRUCTURED_STREAM=1
# AMD_LLM_EXTRA_BODY={}
# AMD_LLM_TEMPERATURE=0.1
# AMD_LLM_CONNECT_TIMEOUT_S=10
# AMD_LLM_TIMEOUT_S=90
# AMD_LLM_STREAM_TIMEOUT_S=120
# AMD_LLM_MAX_CONTEXT_CHARS=24000
# AMD_LLM_MAX_TOKENS_PLANNER=1200
# AMD_LLM_MAX_TOKENS_EXPLAINER=1800
# AMD_LLM_MAX_TOKENS_ALTERNATIVES=1500
# AMD_LLM_MAX_TOKENS_ASSISTANT=900
